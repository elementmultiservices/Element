{
  "name": "element",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vision-wasm.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/copy-vision-wasm.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=high",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "import:drive": "tsx --conditions=react-server --env-file=.env.local scripts/import-drive.ts",
    "import:clients": "tsx --env-file=.env.local scripts/import-clients.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:deps",
    "db:bundle": "node scripts/bundle-schema.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sentry/nextjs": "11.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "lenis": "1.3.26",
    "lucide-react": "1.52.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

# =============================================================================
# Element — environment variables
# Copy to .env.local for development. In Vercel, set them per environment
# (Production / Preview / Development) using SEPARATE Supabase projects.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are secrets: server-only.
# =============================================================================

# Public base URL of the site (no trailing slash). Used for metadata, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Supabase -----------------------------------------------------------------
# Project URL and publishable (anon) key: safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service role key. BYPASSES RLS. Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions -----------------------------------------------------------------
# Random string, at least 32 characters. Signs the inactivity cookie and keys
# identifier hashes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- reCAPTCHA v3 -------------------------------------------------------------
# Required in production. In development, leaving them empty skips the check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0–1.0) accepted by the server.
RECAPTCHA_MIN_SCORE=0.5

# --- Upstash Redis (rate limiting and sign-in lockout) --------------------------
# Required in production. In development, an in-memory fallback is used when empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (transactional email) ---------------------------------------------
# Required in production. In development, emails are printed to the server console when empty.
RESEND_API_KEY=
# Sender, from a domain verified in Resend.
EMAIL_FROM=Element <no-reply@example.com>
# Inbox that receives contact-form notifications.
CONTACT_INBOX=contact@example.com

# --- Sentry (configured in phase 5) -------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
